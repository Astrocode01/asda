#include <iostream>
#include <vector>
#include <queue>
using namespace std;

class Graph {
    int V;
    vector<pair<int, int>> adj[20];

public:
    Graph(int v) {
        V = v;
    }

    void addEdge(int u, int v, int w) {
        adj[u].push_back({v, w});
        adj[v].push_back({u, w});
    }

    void BFS(int start) {
        bool visited[20] = {};
        queue<int> q;

        visited[start] = true;
        q.push(start);

        cout << "BFS: ";
        while (!q.empty()) {
            int u = q.front();
            q.pop();

            cout << u << " ";

            for (auto x : adj[u]) {
                int v = x.first;
                if (!visited[v]) {
                    visited[v] = true;
                    q.push(v);
                }
            }
        }
        cout << endl;
    }

    void DFSUtil(int u, bool visited[]) {
        visited[u] = true;
        cout << u << " ";

        for (auto x : adj[u]) {
            int v = x.first;
            if (!visited[v])
                DFSUtil(v, visited);
        }
    }

    void DFS(int start) {
        bool visited[20] = {};
        cout << "DFS: ";
        DFSUtil(start, visited);
        cout << endl;
    }

    void display() {
        for (int i = 0; i < V; i++) {
            cout << i << ": ";
            for (auto x : adj[i])
                cout << "(" << x.first << "," << x.second << ") ";
            cout << endl;
        }
    }
};

int main() {
    int n, e;
    cout << "Enter number of departments: ";
    cin >> n;

    Graph g(n);

    cout << "Enter number of connections: ";
    cin >> e;

    cout << "Enter connections (source destination distance):\n";
    for (int i = 0; i < e; i++) {
        int u, v, w;
        cin >> u >> v >> w;
        g.addEdge(u, v, w);
    }

    cout << "\nAdjacency List:\n";
    g.display();

    int start;
    cout << "Enter starting department: ";
    cin >> start;

    g.BFS(start);
    g.DFS(start);

    return 0;
}






