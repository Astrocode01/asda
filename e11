#include <iostream>
#include <climits>
#include <algorithm>
using namespace std;

const int INF = 99999;

void floydWarshall(int dist[20][20], int n) {
    for (int k = 0; k < n; k++) {
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                if (dist[i][k] != INF &&
                    dist[k][j] != INF) {

                    dist[i][j] = min(
                        dist[i][j],
                        dist[i][k] + dist[k][j]
                    );
                }
            }
        }
    }

    cout << "\nShortest Distance Matrix:\n";

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            if (dist[i][j] == INF)
                cout << "INF ";
            else
                cout << dist[i][j] << " ";
        }
        cout << endl;
    }

    for (int i = 0; i < n; i++) {
        if (dist[i][i] < 0) {
            cout << "Negative weight cycle detected\n";
            return;
        }
    }

    cout << "Time Complexity: O(n^3)\n";
    cout << "Space Complexity: O(n^2)\n";
}

int main() {
    int n;
    int dist[20][20];

    cout << "Enter number of vertices: ";
    cin >> n;

    cout << "Enter adjacency matrix (-1 for no edge):\n";

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            cin >> dist[i][j];

            if (dist[i][j] == -1)
                dist[i][j] = INF;
        }
    }

    floydWarshall(dist, n);

    return 0;
}







