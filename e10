#include <iostream>
#include <queue>
#include <vector>
#include <climits>
#include <algorithm>
using namespace std;

const int INF = INT_MAX;

int n;
int cost[20][20];
int bestCost = INF;
vector<int> bestPath;

struct Node {
    int level;
    int current;
    int cost;
    int bound;
    vector<int> path;
};

int calculateBound(Node node) {
    int bound = node.cost;

    for (int i = 0; i < n; i++) {
        if (find(node.path.begin(), node.path.end(), i)
            != node.path.end())
            continue;

        int minCost = INF;

        for (int j = 0; j < n; j++) {
            if (i != j && cost[i][j] != INF)
                minCost = min(minCost, cost[i][j]);
        }

        if (minCost != INF)
            bound += minCost;
    }

    int minReturn = INF;

    for (int j = 0; j < n; j++) {
        if (j != node.current && cost[node.current][j] != INF)
            minReturn = min(minReturn, cost[node.current][j]);
    }

    if (minReturn != INF)
        bound += minReturn;

    return bound;
}

struct Compare {
    bool operator()(Node a, Node b) {
        return a.bound > b.bound;
    }
};

void TSP() {
    priority_queue<Node, vector<Node>, Compare> pq;

    Node root;
    root.level = 0;
    root.current = 0;
    root.cost = 0;
    root.path.push_back(0);
    root.bound = calculateBound(root);

    pq.push(root);

    while (!pq.empty()) {
        Node u = pq.top();
        pq.pop();

        if (u.bound >= bestCost)
            continue;

        if (u.level == n - 1) {
            if (cost[u.current][0] != INF) {
                int total = u.cost + cost[u.current][0];

                if (total < bestCost) {
                    bestCost = total;
                    bestPath = u.path;
                    bestPath.push_back(0);
                }
            }
            continue;
        }

        for (int i = 0; i < n; i++) {
            if (find(u.path.begin(), u.path.end(), i)
                == u.path.end() && cost[u.current][i] != INF) {

                Node v;
                v.level = u.level + 1;
                v.current = i;
                v.cost = u.cost + cost[u.current][i];
                v.path = u.path;
                v.path.push_back(i);

                v.bound = calculateBound(v);

                if (v.bound < bestCost)
                    pq.push(v);
            }
        }
    }

    if (bestCost == INF) {
        cout << "No valid tour exists\n";
        return;
    }

    cout << "\nOptimal Path: ";

    for (int x : bestPath)
        cout << x << " ";

    cout << "\nMinimum Cost: " << bestCost << endl;
}

int main() {
    cout << "Enter number of cities: ";
    cin >> n;

    cout << "Enter cost matrix (-1 for no edge):\n";

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            cin >> cost[i][j];

            if (cost[i][j] == -1)
                cost[i][j] = INF;
        }
    }

    TSP();

    return 0;
}




